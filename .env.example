# Customer Lifetime Value (CLV) & Revenue Forecasting Engine
# Example Environment Configuration (copy to .env for local overrides)

# Database Backend: 'duckdb' (default), 'sqlite', or 'postgres'
DB_BACKEND=duckdb
DB_DUCKDB_PATH=database/clv_engine.duckdb
DB_SQLITE_PATH=database/clv_engine.sqlite

# Optional PostgreSQL Configuration (only if DB_BACKEND=postgres)
DB_PG_HOST=localhost
DB_PG_PORT=5432
DB_PG_NAME=clv_engine
DB_PG_USER=postgres
DB_PG_PASSWORD=your_password_here

# Analytics & Modeling Configuration
DEFAULT_CURRENCY=USD
DEFAULT_CLV_HORIZON_MONTHS=12
DEFAULT_DISCOUNT_RATE=0.10
DEFAULT_GROSS_MARGIN=1.00

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
